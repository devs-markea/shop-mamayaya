# Copia este fichero a .env y ajusta los valores. En SiteGround, el .env vive en la
# carpeta del proyecto (fuera de public_html): ver docs/despliegue-siteground.md.

APP_NAME="Mamá Yaya"
# En SiteGround: production, con APP_DEBUG=false.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# La URL publica de la tienda, sin barra final. En produccion, con https://.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Un archivo por dia en storage/logs, y se borran los de mas de 14 dias: en un hosting
# compartido un laravel.log unico crece sin limite. Los codigos de error que ve el
# comprador (SF-M202, SF-PNET…) van tambien en el log, y se buscan ahi.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# En produccion basta `warning`: `info` deja una linea por cada lectura de la cache.
LOG_LEVEL=debug

# La tienda no tiene base de datos propia: los datos son del ERP y llegan por su API.
# La conexion queda declarada porque Laravel la espera, pero nada la usa.
DB_CONNECTION=sqlite

# Sesion, cache y colas sin base de datos: archivos en storage/, que es lo que un hosting
# compartido sirve sin configurar nada.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En produccion, true: la cookie de sesion solo viaja por https.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===========================================================================
# LA TIENDA
# ===========================================================================

# Origen de la API de la tienda (el ERP en Laravel). Sin barra final y sin valor por
# defecto: `php artisan shop:check` falla nombrandola si falta.
#
# El catalogo, la ficha y el carrito se piden desde el servidor, no desde el navegador:
# el token de sesion vive en una cookie httpOnly de esta tienda y se reenvia a la API en
# la cabecera X-Cart-Token.
API_URL=

# Clave del CLIENTE autorizado de la API (cabecera X-Shop-Key).
#
# Es lo que distingue a esta tienda de cualquiera que conozca la URL de la API. Sin ella,
# el backend sirve el catalogo, la lista de precios y la configuracion del negocio
# —telefono de WhatsApp, CLABE, plantillas— a quien pase por ahi. No sustituye a la sesion
# del comprador: son dos preguntas distintas —que aplicacion habla, y de quien es el
# carrito— y viajan juntas.
#
# ES UN SECRETO DE VERDAD: el navegador NUNCA llama a la API, llama a /api/* de esta tienda
# y es el servidor quien reenvia. El dia que una pantalla llame directo a la API desde el
# navegador, esta clave deja de ser un secreto.
#
# El valor lo genera el backend y es EL MISMO en los dos lados:
#
#     php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# ORDEN DE DESPLIEGUE: se pone PRIMERO aqui y DESPUES en el .env del backend. Mientras el
# backend la tenga vacia no exige nada; al reves, la tienda entera responde 401.
# SHOP_API_KEY=

# Clave con la que el BACKEND pide vaciar la cache de la tienda (cabecera
# X-Cache-Purge-Key de POST /api/cache/invalidate). Es la del boton "Refrescar tienda" de
# Configuracion de la tienda, en el panel.
#
# Otro secreto, NO el de SHOP_API_KEY: aquella la manda esta tienda al backend, esta va al
# reves. El valor es EL MISMO en los dos lados (SHOP_CACHE_PURGE_KEY en el .env del backend).
#
# Sin ella el endpoint responde 503 y no purga nada; el resto de la tienda no cambia.
#
# OJO EN SITEGROUND: si la tienda vive en SiteGround, su antibots puede retar la llamada
# del backend igual que retaba las de la tienda al ERP. El backend tiene que mandarla con
# un User-Agent de navegador (ver services.shop_api.user_agent en config/services.php).
# SHOP_CACHE_PURGE_KEY=

# Clave de NAVEGADOR de Google Maps: el selector de ubicacion de /mamayaya/datos.
#
# Se crea en Google Cloud (APIs y servicios -> Credenciales -> Clave de API) con
# facturacion activa, y le bastan DOS APIs: Maps JavaScript API y Places API (New). La
# Geocoding API NO hace falta: la direccion del punto la resuelve el backend al cotizar.
#
# IMPORTANTE: restringela por referente HTTP a los dominios de la tienda. Viaja al
# navegador —se ve en el codigo de la pagina—, asi que lo que impide que otro la gaste no
# es ocultarla, es esa restriccion.
#
# Sin ella la tienda sigue en pie: la hoja cae al respaldo, que es pedirle la posicion al
# dispositivo.
# GOOGLE_MAPS_API_KEY=

# De donde sale "abierto" o "cerrado", y cuanto se guarda el horario.
#
#   true (o sin poner)  De los RANGOS de horas del horario (`days[].shifts`), calculados
#                       en cada visita en la zona de la tienda. El horario se guarda UNA
#                       SEMANA; un cambio de turnos en el panel se ve al pulsar
#                       "Refrescar tienda".
#   false               Del `isOpen` que resuelve el backend. Ese dato caduca al minuto,
#                       asi que el horario solo se guarda 30 segundos.
#
# En los dos modos el calculo se compara con el servidor: si no coinciden, queda en el log
# "[horario] el calculo desde los rangos no coincide con el servidor".
# SCHEDULE_FROM_SHIFTS=true

# Modo de pruebas: silencia el aviso de la zona de reparto —"entregamos en Cancun…"—
# para que el equipo pueda recorrer el pedido desde donde vive. En produccion, apagado.
# TEST_MODE=false

# El tema de color: el nombre de un JSON de resources/themes/ (gold, green, pink,
# orange). Sin poner es `gold`. Los iconos de public/ NO cambian con el tema: son
# imagenes con el color dentro.
STORE_THEME=pink

# El almacen de la cache de las lecturas (catalogo, horario, configuracion). Lo
# recomendado es dejarlo SIN PONER: usa el CACHE_STORE de arriba (`file`), que sobrevive a
# reinicios y despliegues y conserva la copia de respaldo que se sirve cuando el ERP falla.
# `memcached` no conviene: vive en RAM y se borra al reiniciarse, y con el se pierde esa
# copia. `array` es solo para las pruebas: no guarda nada entre visitas.
# SHOP_CACHE_STORE=
